{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices", ":timezone(Asia/Tokyo)"],
	"labels": ["dependencies"],
	"prHourlyLimit": 0,
	"prConcurrentLimit": 0,
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"minimumReleaseAge": "3 days",
	"prCreation": "not-pending",
	"internalChecksFilter": "strict",
	"assignAutomerge": true,
	"internalChecksAsSuccess": true,
	"reviewersFromCodeOwners": true,
	"separateMultipleMinor": false,
	"separateMultipleMajor": true,
	"separateMinorPatch": false,
	"packageRules": [
		{
			"description": "Automerge minor/patch updates for non-major versions",
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^v?0+\\./",
			"automerge": true
		},
		{
			"description": "Group stable npm and GitHub Actions minor/patch updates by manager",
			"matchManagers": ["npm", "github-actions"],
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^v?0+\\./",
			"groupName": "{{manager}} non-major dependencies"
		},
		{
			"description": "Group stable development tool minor/patch updates together",
			"matchManagers": ["mise", "nodenv"],
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^v?0+\\./",
			"groupName": "development tools (non-major)"
		},
		{
			"description": "Keep pre-1.0 minor/patch updates separate from automerged stable updates",
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "/^v?0+\\./",
			"groupName": "{{manager}} pre-1.0 dependencies"
		},
		{
			"description": "Group linter dependencies together",
			"groupName": "linters",
			"extends": ["packages:linters"],
			"matchPackageNames": ["prettier", "/^@typescript-eslint//"]
		},
		{
			"description": "The root TypeScript serves @typescript-eslint, whose parser accepts typescript below 6.1; Kopje's own TypeScript is packages/kopje's. Held until lint moves to oxlint",
			"matchFileNames": ["package.json"],
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<6.1"
		},
		{
			"description": "No major ESLint updates at the root: lint moves to oxlint after 0.1.0",
			"matchFileNames": ["package.json"],
			"matchPackageNames": ["eslint", "@eslint/js", "@eslint/eslintrc", "/^@typescript-eslint//", "/^eslint-/"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"description": "Group Vitest packages together",
			"groupName": "vitest",
			"matchPackageNames": ["vitest"]
		},
		{
			"description": "Create Vitest major update PRs only after status checks pass",
			"matchManagers": ["npm"],
			"matchPackageNames": ["vitest"],
			"matchUpdateTypes": ["major"],
			"prCreation": "status-success"
		},
		{
			"description": "kopje is this repository's own package: bump the deploy/ template as soon as a version is on npm, release candidates included",
			"matchPackageNames": ["kopje"],
			"matchFileNames": ["deploy/package.json"],
			"minimumReleaseAge": null,
			"ignoreUnstable": false
		},
		{
			"description": "Update Kopje (packages/kopje and the deploy/ template) in pull requests of its own",
			"matchFileNames": ["packages/kopje/**", "deploy/**"],
			"additionalBranchPrefix": "kopje-",
			"commitMessageSuffix": "(kopje)"
		}
	]
}
