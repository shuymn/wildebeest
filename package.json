{
	"name": "wildebeest",
	"version": "0.1.0",
	"type": "module",
	"author": "Sven Sauleau <sven@cloudflare.com>",
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"eslint": "10.13.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"lefthook": "2.2.1",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"vitest": "5.0.5",
		"wrangler": "4.149.0"
	},
	"private": true,
	"scripts": {
		"pretty": "npx prettier --list-different './**/*.{ts,tsx,js,jsx,json,css}'",
		"test": "vitest run",
		"lint:kopje": "pnpm --filter kopje lint",
		"check:kopje-package": "node scripts/check-kopje-package.mjs",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"prepare": "lefthook install"
	},
	"packageManager": "pnpm@10.34.7"
}
