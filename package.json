{
  "name": "kopje-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretty": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "check:kopje-package": "node scripts/check-kopje-package.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
