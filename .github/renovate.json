{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shuymn/github-actions#main"],
  "constraints": {
    "pnpm": "12"
  },
  "mise": {
    "enabled": false
  },
  "github-actions": {
    "managerFilePatterns": ["/^deploy/ci/[^/]+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Group Vitest and its packages, whose versions must match exactly",
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/**"]
    },
    {
      "description": "Group the oxc tools, which change what lint and format report together",
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxlint-tsgolint", "oxfmt", "@oxlint/**"]
    },
    {
      "description": "kopje is this repository's own package: bump the deploy/ template as soon as a version is on npm",
      "matchPackageNames": ["kopje"],
      "matchFileNames": ["deploy/package.json"],
      "minimumReleaseAge": null
    }
  ]
}
