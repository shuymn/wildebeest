{
	"name": "@wildebeest/frontend",
	"description": "App with Routing built-in (recommended)",
	"type": "module",
	"engines": {
		"node": ">=24.17.0"
	},
	"private": true,
	"scripts": {
		"pretypes-check": "pnpm --dir ../.. --filter @wildebeest/backend exec tsc -b && pnpm run build",
		"types-check": "tsc --noEmit",
		"lint": "eslint src mock-db adapters",
		"build": "vite build && vite build --config adapters/cloudflare-pages/vite.config.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@builder.io/qwik": "1.20.2",
		"@playwright/test": "1.64.0",
		"@builder.io/qwik-city": "1.20.2",
		"@types/eslint": "9.6.1",
		"@types/node": "24.19.2",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"autoprefixer": "10.6.1",
		"esbuild": "0.28.1",
		"eslint": "9.39.5",
		"eslint-plugin-qwik": "1.20.2",
		"hono": "4.13.13",
		"lorem-ipsum": "2.0.10",
		"miniflare": "4.20260730.0",
		"postcss": "8.5.30",
		"prettier": "3.9.10",
		"sass": "1.105.1",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"undici": "8.12.2",
		"vite": "6.4.4",
		"vite-tsconfig-paths": "6.1.1"
	},
	"dependencies": {
		"@wildebeest/backend": "workspace:*",
		"modern-normalize": "3.0.1"
	}
}
