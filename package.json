{
  "name": "kopje-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretty": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "check:kopje-package": "node scripts/check-kopje-package.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "lefthook": "2.2.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  }
}
