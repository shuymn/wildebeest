{
  "name": "kopje-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretty": "oxfmt --check",
    "test": "vitest run",
    "lint:kopje": "pnpm --filter kopje lint",
    "check:kopje-package": "node scripts/check-kopje-package.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "lefthook": "2.2.1",
    "oxfmt": "0.74.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  }
}
