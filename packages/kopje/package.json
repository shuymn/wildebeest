{
	"name": "kopje",
	"version": "0.0.0",
	"description": "A Fediverse server on a single Cloudflare Worker. A spiritual successor of cloudflare/wildebeest, not affiliated with Cloudflare.",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"bin": {
		"kopje-admin": "./cli/kopje-admin.js"
	},
	"scripts": {
		"lint": "eslint src test cli test-node --quiet",
		"test": "vitest run && vitest run -c vitest.node.config.ts",
		"typecheck": "tsc --noEmit && tsc -p cli && tsc -p test-node",
		"types": "wrangler types --include-runtime=false",
		"build": "wrangler deploy --dry-run --outdir dist"
	},
	"dependencies": {
		"@fedify/fedify": "2.4.2",
		"@fedify/vocab": "2.4.2",
		"es-toolkit": "1.46.1",
		"hono": "4.12.27",
		"jose": "6.2.12",
		"linkify-it": "6.1.0",
		"temporal-polyfill": "1.0.5",
		"xss": "1.0.15",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.16.20",
		"@cloudflare/workers-types": "4.20260627.1",
		"@fedify/testing": "2.4.2",
		"miniflare": "4.20260625.0",
		"parse5": "8.0.1",
		"typescript": "5.9.3",
		"vitest": "4.1.9",
		"wrangler": "4.105.0"
	}
}
