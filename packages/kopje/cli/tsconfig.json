{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true
	},
	"include": ["**/*.js"]
}
